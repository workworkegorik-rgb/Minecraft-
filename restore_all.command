echo "  skins/the_deep_hd.png"

# Подключаем автокликер к Hammerspoon, если он ещё не подключён
HS_DIR="$HOME/.hammerspoon"
mkdir -p "$HS_DIR"
cp "$DEST/autoclicker.lua" "$HS_DIR/autoclicker.lua"
if ! grep -qs -e 'require("autoclicker")' -e "MARKER = 987654321" "$HS_DIR/init.lua"; then
    echo 'require("autoclicker")' >> "$HS_DIR/init.lua"
fi

if [ -d "/Applications/Hammerspoon.app" ]; then
    # Перезапуск, чтобы Hammerspoon подхватил конфиг
    osascript -e 'quit app "Hammerspoon"' >/dev/null 2>&1 || true
    sleep 1
    open -a Hammerspoon
    echo "Автокликер запущен: R - вкл/выкл, держи ЛКМ или ПКМ."
    echo "Если не кликает: Системные настройки > Конфиденциальность > Универсальный доступ > Hammerspoon."
else
    echo "Hammerspoon не установлен: скачай с https://www.hammerspoon.org и запусти этот файл ещё раз."
fi

echo "Скины: $DEST/skins (загрузить на minecraft.net в профиле)"
open "$DEST" 2>/dev/null || true
